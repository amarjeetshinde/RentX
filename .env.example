# ─────────────────────────────────────────────────────────────────────────────
# RentX — Production & Development Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT SECURITY RULES:
#   • NEVER commit real keys, tokens, or credentials into source control.
#   • Vite exposes all variables prefixed with VITE_ to the frontend bundle.
#   • Server secrets (like RAZORPAY_KEY_SECRET) must NOT have the VITE_ prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Public Client (Frontend) ─────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# ── Razorpay Payment Gateway (Test Mode / Production) ─────────────────────────
# Public Key ID (safe for frontend popup initialisation)
VITE_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere

# Secret Key (STRICTLY SERVER-SIDE - NEVER EXPOSE TO FRONTEND)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Optional: Production Server Configuration ────────────────────────────────
PORT=3001
NODE_ENV=production
# Frontend URL for CORS when running standalone server
CLIENT_URL=https://rentx.yourdomain.com
